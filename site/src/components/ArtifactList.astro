---
interface Artifact {
  name: string;
  type: string;
  description: string;
}

interface Props {
  items: Artifact[];
}

const { items } = Astro.props;
---

<div class="artifact-list">
  <table>
    <thead>
      <tr>
        <th>Artefacto</th>
        <th>Tipo</th>
        <th>Qué es</th>
      </tr>
    </thead>
    <tbody>
      {
        items.map((item) => (
          <tr>
            <td class="name">
              <code>{item.name}</code>
            </td>
            <td>
              <span class="tag">{item.type}</span>
            </td>
            <td class="description">{item.description}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .artifact-list {
    overflow-x: auto;
    margin: 1.25rem 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .artifact-list table {
    margin: 0;
    min-width: 560px;
  }

  .artifact-list th:first-child,
  .artifact-list td:first-child {
    padding-left: 1rem;
  }

  .artifact-list th:last-child,
  .artifact-list td:last-child {
    padding-right: 1rem;
  }

  .name {
    white-space: nowrap;
    vertical-align: top;
  }

  .description {
    color: var(--text-muted);
    font-size: 0.92rem;
  }
</style>
