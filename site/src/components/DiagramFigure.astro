---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  wide?: boolean;
}

const { src, alt, caption, wide = false } = Astro.props;
---

<figure class:list={["diagram", { wide }]}>
  <div class="diagram-card">
    <img src={src} alt={alt} loading="lazy" />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .diagram {
    margin: 1.75rem 0;
  }

  .diagram.wide {
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  .diagram-card {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.75rem;
    overflow-x: auto;
  }

  .diagram.wide .diagram-card {
    max-width: 1080px;
    margin: 0 auto;
  }

  .diagram img {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-align: center;
  }
</style>
