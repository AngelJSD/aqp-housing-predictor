# Copiar a .env y ajustar si hace falta. Todos los servicios corren en la
# misma red de Docker Compose; los host_ports de abajo son solo para acceso
# desde tu máquina (psql, redis-cli, UI de MLflow, etc.) — dentro de la red
# de Compose cada servicio se resuelve por su nombre de servicio (postgres,
# redis, mlflow, feast) en su puerto interno de siempre.

# --- Postgres ---
# Una sola instancia de Postgres para todo el stack: la DB principal guarda
# `feature_metadata` (y, desde el paso 5, el offline store de Feast); MLflow
# usa una DB separada dentro de la misma instancia para no mezclar sus
# tablas internas con las nuestras.
POSTGRES_USER=aqp
POSTGRES_PASSWORD=changeme_dev_password
POSTGRES_DB=aqp_housing
POSTGRES_MLFLOW_DB=mlflow
POSTGRES_HOST_PORT=5432

# --- Redis (Feast online store) ---
REDIS_HOST_PORT=6379

# --- MLflow ---
# Backend store: Postgres, DB separada (ver arriba). Artifacts: servidos
# proxied por el propio servidor de MLflow (--serve-artifacts, default) y
# guardados en su disco en MLFLOW_ARTIFACTS_DESTINATION, bind-mounteado a
# ./mlruns (ya ignorado en git) — no hay S3/blob storage en este stack.
# Importante: NO usar --default-artifact-root con un path plano — el
# cliente de MLflow intenta escribir ahí directo en su propio filesystem
# (asumiendo storage compartido con el servidor), rompiendo para cualquier
# cliente que no comparta el volumen del contenedor.
MLFLOW_BACKEND_STORE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_MLFLOW_DB}
MLFLOW_ARTIFACTS_DESTINATION=/mlruns
# Host 5001, no 5000: en Mac, 5000 lo toma AirPlay Receiver/ControlCenter.
MLFLOW_HOST_PORT=5001

# --- Feast feature server ---
# Puerto default de `feast serve`.
FEAST_HOST_PORT=6566

# --- Feast, para scripts que corren en el host (no dentro de un contenedor) ---
# El servicio `feast` en docker-compose.yml resuelve feature_store.yaml con
# POSTGRES_HOST=postgres/REDIS_HOST=redis hardcodeados en su propio
# `environment:` (no leídos de este .env) — son los nombres de servicio
# internos de la red de Compose. Un script como ml/training/train.py, que
# corre en el host y también resuelve el mismo feature_store.yaml, necesita
# en cambio localhost + los host_ports mapeados de arriba. Sin colisión con
# lo anterior: el `feast` service nunca lee estas dos variables del .env.
POSTGRES_HOST=localhost
POSTGRES_PORT=${POSTGRES_HOST_PORT}
REDIS_HOST=localhost
REDIS_PORT=${REDIS_HOST_PORT}

# --- MLflow, para scripts que corren en el host ---
# Mismo motivo que arriba: el cliente MLflow de train.py corre en el host,
# no dentro de la red de Compose.
MLFLOW_TRACKING_URI=http://localhost:${MLFLOW_HOST_PORT}

# --- API de inferencia (Node/Fastify) ---
API_HOST_PORT=3000

# --- Prometheus ---
PROMETHEUS_HOST_PORT=9090

# --- Dashboard (Next.js) ---
DASHBOARD_HOST_PORT=3002
